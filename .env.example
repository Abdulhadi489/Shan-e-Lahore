# Frontend (public values, bundled into the site). Copy to .env.local, which git ignores.
# Local Supabase: VITE_SUPABASE_URL and the publishable key come from `supabase status`.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Local development: Cloudflare's always-pass test key 1x00000000000000000000AA.
# Hosted dev project: the real site key (its widget must allow localhost).
VITE_TURNSTILE_SITE_KEY=

# Never put the Supabase secret key or the Turnstile secret here.
# They live only in Supabase Edge Function secrets and Supabase Auth settings.
