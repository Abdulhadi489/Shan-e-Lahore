# Edge Function secrets. Copy to supabase/functions/.env for local development (git ignores it).
# On the hosted project set them with: supabase secrets set --env-file supabase/functions/.env
# Never commit real values.

# Turnstile secret for the widget's site key. Locally: Cloudflare's always-pass test secret.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Comma-separated origins allowed to call the functions (no trailing slash).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
